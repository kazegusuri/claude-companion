{
  "name": "claude-companion-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "tsc -b && bunx --bun vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -b --noEmit",
    "check:all": "bun run typecheck && bun run check",
    "preview": "bunx --bun vite preview",
    "serve": "bunx --bun vite preview --port 3001",
    "start": "bun run build && bun run serve",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "tsp:compile": "cd ../api && npx tsp compile .",
    "tsp:types": "npx openapi-typescript ../api/tsp-output/@typespec/openapi3/openapi.yaml -o src/types/api.ts",
    "tsp:generate": "bun run tsp:compile && bun run tsp:types"
  },
  "dependencies": {
    "@mantine/core": "^8.2.4",
    "@mantine/hooks": "^8.2.4",
    "@tabler/icons-react": "^3.34.1",
    "pixi-live2d-display-lipsyncpatch": "^0.5.0-ls-8",
    "pixi.js": "7",
    "react": "18",
    "react-dom": "18",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.3.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typespec/compiler": "^1.3.0",
    "@typespec/http": "^1.3.0",
    "@typespec/json-schema": "^1.3.0",
    "@typespec/openapi3": "^1.3.0",
    "@typespec/rest": "^0.73.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.9.1",
    "sharp": "^0.34.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  }
}
