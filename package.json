{
  "name": "claude-companion",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "bun run --filter claude-companion-web dev",
    "build": "bun run --filter claude-companion-web build",
    "lint": "bun run --filter claude-companion-web lint",
    "format": "bun run --filter claude-companion-web format",
    "check": "bun run --filter claude-companion-web check",
    "preview": "bun run --filter claude-companion-web preview",
    "serve": "bun run --filter claude-companion-web serve",
    "start": "bun run build && bun run serve",
    "test:e2e": "bun run --filter claude-companion-web test:e2e",
    "web:dev": "bun run --filter claude-companion-web dev",
    "web:build": "bun run --filter claude-companion-web build",
    "web:install": "bun install --cwd web",
    "web:tsp:generate": "bun run --filter claude-companion-web tsp:generate",
    "web:tsp:compile": "bun run --filter claude-companion-web tsp:compile",
    "web:tsp:types": "bun run --filter claude-companion-web tsp:types",
    "api:compile": "npm run --workspace=api compile",
    "api:compile:watch": "npm run --workspace=api compile:watch",
    "api:format": "npm run --workspace=api format",
    "api:install": "npm install --workspace=api",
    "backend:build": "make build",
    "backend:run": "make run",
    "backend:test": "make test",
    "backend:fmt": "make fmt",
    "generate-types": "npm run api:compile && bun run web:tsp:types",
    "install:all": "npm install --workspace=api && bun install --cwd web"
  },
  "devDependencies": {}
}